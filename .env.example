# Porta do servidor
PORT=3000

# Modo de ambiente
NODE_ENV=development

# Usar dados mockados para desenvolvimento (true/false)
USE_MOCK_DATA=true

# Configurações do Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=60000

# Configurações da API externa de voos (para uso futuro)
FLIGHT_API_URL=https://api.exemplo.com/v1
FLIGHT_API_KEY=sua_chave_api_aqui

# Configurações de notificação
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=senha_segura
